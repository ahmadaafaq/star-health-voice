    "twilio": "^5.5.0",
    "livekit-server-sdk": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2"
