  "description": "Automated outbound call scheduler for Star Health Insurance using ElevenLabs AI + Twilio",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --outDir dist && tsc-alias",
